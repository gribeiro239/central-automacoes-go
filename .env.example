# Go reads the process environment; this file is a reference, not auto-loaded.
HTTP_ADDR=127.0.0.1:18081
STORAGE=memory
WORKERS=4
POLL_INTERVAL=250ms
SCHEDULER_INTERVAL=500ms
RETRY_BASE=5s
SHUTDOWN_TIMEOUT=20s

# For Compose: copy this file to .env and choose a local password.
POSTGRES_USER=central
POSTGRES_DB=central
POSTGRES_PASSWORD=
POSTGRES_PORT=55432
# For the Go process: set STORAGE=postgres and DATABASE_URL explicitly.
# DATABASE_URL=postgres://central:SENHA_URL_ENCODED@127.0.0.1:55432/central?sslmode=disable
